@startuml
title Diagramme de classes complet - Gestion TP

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle

' =====================
' Enumerations
' =====================
enum RoleUtilisateur {
  student
  teacher
  admin
}

enum StatutCours {
  active
  archived
}

enum StatutTP {
  draft
  published
  closed
}

enum StatutSoumission {
  submitted
  graded
  late
}

enum StatutPresence {
  present
  absent
  late
  excused
}

enum TypePublication {
  announcement
  tp_posted
  reminder
  general
}

enum TypeNotification {
  new_tp
  submission_graded
  new_submission
  new_post
  reminder
  student_joined
  comment
  like
  comment_like
}

' =====================
' Utilisateurs
' =====================
class Utilisateur {
  +id: bigint
  +name: String
  +email: String
  -password: String
  +role: RoleUtilisateur
  +profile_picture: String?
  +show_email_publicly: Boolean
  +must_reset_password: Boolean
  +isStudent(): Boolean
  +isTeacher(): Boolean
  +isAdmin(): Boolean
}

class Etudiant {
  +rejoindreCours(code: String)
  +consulterCours()
  +consulterTP()
  +soumettreTP()
  +modifierSoumission()
  +consulterProgression()
}

class Enseignant {
  +creerCours()
  +modifierCours()
  +publierTP()
  +noterSoumission()
  +prendrePresence()
  +publierAnnonce()
}

class Administrateur {
  +gererUtilisateurs()
  +gererCours()
  +gererParametresSysteme()
  +consulterStatistiques()
}

Utilisateur <|-- Etudiant
Utilisateur <|-- Enseignant
Utilisateur <|-- Administrateur

note right of Utilisateur
  Dans l'application Laravel, Etudiant,
  Enseignant et Administrateur ne sont pas
  trois tables separees.

  Ils representent des roles portes par
  Utilisateur.role.
end note

' =====================
' Cours, TP, soumissions
' =====================
class Cours {
  +id: bigint
  +name: String
  +description: Text?
  +teacher_id: bigint?
  +join_code: String
  +status: StatutCours
  +course_pdf: String?
  +course_doc_id: String?
  +generateUniqueJoinCode(): String
  +regenerateJoinCode(): String
  +scopeActive()
  +scopeOwnedBy(teacherId: bigint)
}

class Inscription {
  +id: bigint
  +class_id: bigint
  +student_id: bigint
  +created_at: DateTime
  +updated_at: DateTime
}

class TP {
  +id: bigint
  +title: String
  +description: Text?
  +teacher_id: bigint
  +class_id: bigint
  +due_date: DateTime?
  +status: StatutTP
  +attachments: Json?
  +publier()
  +modifier()
  +fermer()
}

class Soumission {
  +id: bigint
  +tp_id: bigint
  +student_id: bigint
  +content: Text?
  +attachments: Json?
  +grade: Decimal?
  +teacher_comment: Text?
  +status: StatutSoumission
  +submitted_at: DateTime
  +soumettre()
  +modifier()
  +noter()
}

class Presence {
  +id: bigint
  +student_id: bigint
  +class_id: bigint
  +teacher_id: bigint
  +date: Date
  +status: StatutPresence
  +notes: Text?
  +enregistrer()
  +modifier()
}

Enseignant "1" -- "0..*" Cours : cree / gere
Etudiant "1" -- "0..*" Inscription : effectue
Cours "1" -- "0..*" Inscription : contient
Inscription "0..*" -- "1" Etudiant : concerne

Cours "1" -- "0..*" TP : contient
Enseignant "1" -- "0..*" TP : publie
TP "1" -- "0..*" Soumission : recoit
Etudiant "1" -- "0..*" Soumission : depose
Enseignant "1" -- "0..*" Soumission : corrige

Cours "1" -- "0..*" Presence : possede
Etudiant "1" -- "0..*" Presence : est marque
Enseignant "1" -- "0..*" Presence : enregistre

note bottom of Inscription
  Table pivot class_student.
  Elle realise la relation N..N:
  un etudiant peut rejoindre plusieurs cours,
  un cours contient plusieurs etudiants.
end note

note right of Presence
  Contrainte metier:
  une seule presence par
  etudiant, cours et date.

  UNIQUE(student_id, class_id, date)
end note

' =====================
' Flux social: publications, commentaires, likes
' =====================
class Publication {
  +id: bigint
  +user_id: bigint
  +class_id: bigint?
  +tp_id: bigint?
  +type: TypePublication
  +title: String
  +content: Text
  +attachment: String?
  +publier()
  +modifier()
  +supprimer()
  +visibleToStudent(studentId: bigint)
}

class Commentaire {
  +id: bigint
  +post_id: bigint
  +user_id: bigint
  +parent_id: bigint?
  +content: Text
  +ajouter()
  +repondre()
  +supprimer()
}

class Like {
  +id: bigint
  +user_id: bigint
  +likeable_id: bigint
  +likeable_type: String
  +ajouter()
  +retirer()
}

Utilisateur "1" -- "0..*" Publication : publie
Cours "0..1" -- "0..*" Publication : cible
TP "0..1" -- "0..*" Publication : annonce
Publication "1" -- "0..*" Commentaire : recoit
Utilisateur "1" -- "0..*" Commentaire : ecrit
Commentaire "0..1" -- "0..*" Commentaire : reponses
Utilisateur "1" -- "0..*" Like : donne
Publication "1" .. "0..*" Like : peut recevoir
Commentaire "1" .. "0..*" Like : peut recevoir

note bottom of Like
  Association polymorphe Laravel:
  Like.likeable_type + Like.likeable_id
  permettent d'aimer une Publication
  ou un Commentaire.
end note

note right of Publication
  class_id nullable:
  une publication sans cours est une
  annonce generale de l'enseignant.

  tp_id nullable:
  seulement renseigne pour une annonce
  liee a un TP.
end note

' =====================
' Notifications et parametrage
' =====================
class Notification {
  +id: bigint
  +user_id: bigint
  +type: TypeNotification
  +title: String
  +message: Text
  +link: String?
  +related_id: bigint?
  +is_read: Boolean
  +markAsRead()
  +createFor(userId, type, title, message, link, relatedId)
}

class ParametreNotification {
  +id: bigint
  +user_id: bigint
  +class_id: bigint?
  +new_tp_notifications: Boolean
  +submission_graded_notifications: Boolean
  +new_submission_notifications: Boolean
  +post_notifications: Boolean
  +student_joined_notifications: Boolean
  +comment_notifications: Boolean
  +like_notifications: Boolean
  +comment_like_notifications: Boolean
  +getFor(userId, classId)
  +shouldNotify(userId, classId, type): Boolean
}

class ParametreSysteme {
  +id: bigint
  +key: String
  +value: Text?
  +type: String
  +description: Text?
  +get(key, default)
  +set(key, value, type, description)
}

class Statistiques {
  +nombrePresences: Integer
  +tauxCorrection: Float
  +tauxReussite: Float
  +soumissionsRecentes: List<Soumission>
  +consulterStatistiques()
}

Utilisateur "1" -- "0..*" Notification : recoit
Utilisateur "1" -- "0..*" ParametreNotification : configure
Cours "0..1" -- "0..*" ParametreNotification : personnalise
Administrateur "1" -- "0..*" ParametreSysteme : gere
Administrateur "1" ..> Statistiques : consulte
Statistiques ..> Presence : calcule
Statistiques ..> Soumission : analyse

note right of Notification
  related_id est une reference generique
  vers l'objet concerne par la notification
  (TP, Soumission, Publication, etc.).
end note

note bottom of ParametreNotification
  class_id nullable:
  si null, les preferences sont globales.
  Sinon, elles s'appliquent a un cours.
end note

@enduml
